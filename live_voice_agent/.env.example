# Google Gen AI / ADK API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model for Live Voice Understanding
# Options: gemini-2.0-flash, gemini-2.5-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Server Port
PORT=3003

# Voice Agent Persona & Instructions
VOICE_AGENT_NAME=Aria
VOICE_AGENT_PERSONA=helpful, articulate, fast, and conversational live voice assistant
