# Google Gemini API Key
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override Gemini Model (defaults to gemini-2.5-flash or gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# SQLite Database Storage Path (defaults to ./data/shipping_docs.db)
DATABASE_PATH=./data/shipping_docs.db
