# Google Gen AI / ADK API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model for Multi-Turn Agent
# Options: gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Server Port
PORT=3004

# Agent Identity & Behavior
AGENT_NAME=Nexus
AGENT_ROLE=an advanced multi-turn conversational AI assistant with memory, multi-step reasoning, and dynamic tool execution
MAX_HISTORY_TURNS=50
ENABLE_AUTO_TOOL_CALLING=true
